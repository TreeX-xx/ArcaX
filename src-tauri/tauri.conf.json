{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcaX",
  "version": "0.0.3",
  "identifier": "app.arcax.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArcaX - S3 Explorer",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": false,
        "transparent": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' asset: https: http: data:; connect-src 'self' https: ipc:; frame-src 'self' https: http:; media-src 'self' https: http:; object-src 'self' https: http:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 TreeX-xx and Claude",
    "publisher": "ArcaX",
    "category": "Utility",
    "shortDescription": "A fast, focused S3 browser and desktop client.",
    "longDescription": "ArcaX is a fast desktop S3 browser for AWS S3 and S3-compatible object storage including MinIO, Cloudflare R2, Wasabi, DigitalOcean Spaces, and custom endpoints. Built with Rust and Tauri, it offers prefix navigation, deep search, secure local profiles, previews, and transfer controls for large object stores.",
    "license": "MIT",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    }
  },
  "plugins": {}
}
